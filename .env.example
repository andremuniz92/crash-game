# Copie para .env e ajuste. O .env nunca vai para o repositório.
# As URLs abaixo são para rodar dentro do AI Jail (rede crash-game, postgres:5432).
# Rodando no host, troque DATABASE_URL e TEST_DATABASE_URL pelas versões
# comentadas com localhost:5433 (README, "Onde rodar").

# Postgres (docker-compose.yml)
POSTGRES_USER=crash
POSTGRES_PASSWORD=crash
POSTGRES_DB=crash_game
# Porta publicada no host (127.0.0.1): usada ao rodar no host e por psql/DBeaver.
# Dentro da rede crash-game o banco é sempre postgres:5432.
POSTGRES_PORT=5433

# API (D43). Usuário e senha repetem os de cima.
DATABASE_URL=postgres://crash:crash@postgres:5432/crash_game
# No host: DATABASE_URL=postgres://crash:crash@localhost:5433/crash_game
# Testes de integração (D39, D40): banco separado, o nome precisa terminar em _test.
# O globalSetup cria esse banco se ele não existir.
TEST_DATABASE_URL=postgres://crash:crash@postgres:5432/crash_game_test
# No host: TEST_DATABASE_URL=postgres://crash:crash@localhost:5433/crash_game_test

# Opcionais da API (D64), com os padrões. Descomente para mudar.
# PORT=3000
# BETTING_MS=10000
# PAUSE_MS=3000
# TICK_MS=100
# WS_HEARTBEAT_MS=30000

# Acesso externo a partir do host (DBeaver, psql):
#   postgres://crash:crash@localhost:5433/crash_game
